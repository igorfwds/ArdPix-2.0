# Flask Configuration
FLASK_SECRET_KEY=change-this-to-a-random-secret-key-in-production
FLASK_ENV=development
FLASK_DEBUG=True

# AbacatePay Webhook Configuration
WEBHOOK_SECRET=seu-webhook-secret-aqui

# MQTT Broker Configuration
# Para desenvolvimento local (Mosquitto):
# MQTT_BROKER=localhost
# MQTT_PORT=1883
# MQTT_USE_TLS=False

# Para produção (HiveMQ Cloud ou outro broker na nuvem):
MQTT_BROKER=your-cluster.s1.eu.hivemq.cloud
MQTT_PORT=8883
MQTT_USERNAME=seu-usuario-hivemq
MQTT_PASSWORD=sua-senha-hivemq
MQTT_USE_TLS=True

# Opcional: Para produção
# DATABASE_URL=sqlite:///ardpix.db
