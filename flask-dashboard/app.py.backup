def verify_abacate_signature(raw_body: str, signature_from_header: str) -> bool:
    """Verifica a assinatura HMAC do webhook do AbacatePay"""
    try:
        expected_sig = hmac.new(
            ABACATEPAY_PUBLIC_KEY.encode('utf-8'),
            raw_body.encode('utf-8'),
            hashlib.sha256
        ).digest()

        expected_b64 = hashlib.sha256(expected_sig).hexdigest()

        # Comparação segura
        return hmac.compare_digest(expected_b64, signature_from_header)
    except Exception as e:
        print(f"Erro na verificação de assinatura: {e}")
        return False

def on_mqtt_connect(client, userdata, flags, rc):
    """Callback quando conecta ao MQTT"""
    print(f"\n{'='*60}")
    print(f"MQTT CONEXÃO ESTABELECIDA")
    print(f"{'='*60}")
    print(f"Return Code: {rc}")

    if rc == 0:
        print("✅ Conectado com sucesso ao MQTT broker")

        # Limpar mensagens retidas antes de se inscrever
        print("🧹 Limpando mensagens retidas...")
        client.publish(MQTT_TOPIC_PIX_REQUEST, None, retain=True)
        client.publish(MQTT_TOPIC_PIX_RESPONSE, None, retain=True)

        print("📡 Inscrevendo em tópicos...")
        client.subscribe(MQTT_TOPIC_STATUS)
        print(f"   ✅ {MQTT_TOPIC_STATUS}")
        client.subscribe(MQTT_TOPIC_VALUE_UPDATE)
        print(f"   ✅ {MQTT_TOPIC_VALUE_UPDATE}")
        client.subscribe(MQTT_TOPIC_PIX_REQUEST)
        print(f"   ✅ {MQTT_TOPIC_PIX_REQUEST}")
        print(f"{'='*60}\n")
    else:
        print(f"❌ Falha ao conectar. Código de retorno: {rc}")
        print(f"{'='*60}\n")

def on_mqtt_message(client, userdata, msg):
    """Callback quando recebe mensagem MQTT"""
    try:
        payload_str = msg.payload.decode()
        print(f"\n[MQTT DEBUG] Tópico: {msg.topic}")
        print(f"[MQTT DEBUG] Payload: {payload_str}")

        if not payload_str:
            print("[MQTT DEBUG] Mensagem vazia, ignorando")
            return

        payload = json.loads(payload_str)

        if msg.topic == MQTT_TOPIC_STATUS:
            # Atualiza status do ESP32
            esp32_status['connected'] = payload.get('connected', False)
            esp32_status['last_seen'] = datetime.now().isoformat()
            esp32_status['current_value'] = payload.get('current_value', 0.0)

            def emit_status():
                socketio.emit('esp32_status', esp32_status, namespace='/')
                print(f"[WEBSOCKET] ✅ Emitido esp32_status")

            socketio.start_background_task(emit_status)

        elif msg.topic == MQTT_TOPIC_VALUE_UPDATE:
            # Atualização de valor em tempo real
            esp32_status['current_value'] = payload.get('value', 0.0)
            esp32_status['last_seen'] = datetime.now().isoformat()

            value_data = {'value': esp32_status['current_value']}

            # Emitir usando background task para garantir que funcione
            def emit_value():
                socketio.emit('value_update', value_data, namespace='/')
                print(f"[WEBSOCKET] ✅ Emitido value_update: {value_data}")

            socketio.start_background_task(emit_value)
            print(f"[VALOR] R$ {esp32_status['current_value']:.2f}")

        elif msg.topic == MQTT_TOPIC_PIX_REQUEST:
            # ESP32 solicitou geração de PIX
            amount = payload.get('amount', 0.0)
            timestamp = payload.get('timestamp', 0)

            # Criar chave única para esta requisição
            request_key = f"{amount}_{timestamp}"

            # Verificar se já processamos esta requisição
            if request_key in processed_requests:
                print(f"[MQTT] Requisição duplicada ignorada: {request_key}")
                return

            # Adicionar ao cache (limitar tamanho)
            processed_requests.add(request_key)
            if len(processed_requests) > 100:
                processed_requests.clear()

            print(f"\n=== Requisição de PIX recebida ===")
            print(f"Valor: R$ {amount:.2f}")
            print(f"Request Key: {request_key}")

            if amount > 0:
                handle_pix_request_from_esp32(amount)
            else:
                print("Valor inválido, ignorando requisição")
                send_pix_response(False, "Valor inválido")

    except Exception as e:
        print(f"\n❌ ERRO ao processar mensagem MQTT: {e}")
        import traceback
        traceback.print_exc()
        print()

# Configurar callbacks MQTT
mqtt_client.on_connect = on_mqtt_connect
mqtt_client.on_message = on_mqtt_message

# Conectar ao broker MQTT em thread separada
def connect_mqtt():
    try:
        print(f"\n{'='*60}")
        print(f"INICIANDO CONEXÃO MQTT")
        print(f"{'='*60}")
        print(f"Broker: {MQTT_BROKER}")
        print(f"Porta: {MQTT_PORT}")
        print(f"Usuário: {MQTT_USERNAME}")
        print(f"TLS: {MQTT_USE_TLS}")
        print(f"{'='*60}\n")

        # Configurar autenticação se fornecida
        if MQTT_USERNAME and MQTT_PASSWORD:
            mqtt_client.username_pw_set(MQTT_USERNAME, MQTT_PASSWORD)
            print(f"✅ Autenticação MQTT configurada para usuário: {MQTT_USERNAME}")

        # Configurar TLS/SSL se habilitado
        if MQTT_USE_TLS:
            mqtt_client.tls_set(cert_reqs=ssl.CERT_REQUIRED, tls_version=ssl.PROTOCOL_TLSv1_2)
            mqtt_client.tls_insecure_set(False)
            print("✅ TLS/SSL habilitado para MQTT")

        print(f"\n🔄 Conectando ao broker: {MQTT_BROKER}:{MQTT_PORT}...")
        mqtt_client.connect(MQTT_BROKER, MQTT_PORT, 60)
        mqtt_client.loop_start()
        print("✅ Cliente MQTT iniciado com sucesso!\n")
    except Exception as e:
        print(f"\n❌ ERRO ao conectar ao MQTT: {e}\n")
        import traceback
        traceback.print_exc()

# Iniciar conexão MQTT
threading.Thread(target=connect_mqtt, daemon=True).start()

