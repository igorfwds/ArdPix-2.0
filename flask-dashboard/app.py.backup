MQTT_TOPIC_STATUS = 'ardpix/status'

# AbacatePay API
ABACATEPAY_API_KEY = os.getenv('ABACATEPAY_API_KEY', 'abc_prod_06pQKYs0XTpZFnwBSk1MHtbf')
